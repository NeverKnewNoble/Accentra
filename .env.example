# Copy this file to .env.local and fill in the values from your Supabase project.
# Dashboard > Connect (top bar), or Settings > API Keys.
#
# Only VITE_-prefixed variables reach the browser bundle. Never put a
# secret key (sb_secret_...) or service_role key in this file — anything
# here ships to every visitor's browser.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
